# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: faster local test database (role must be NOSUPERUSER so RLS applies)
# TEST_DATABASE_URL=postgresql://brite_test:brite_test@localhost:5432/brite_test

# Front end origins allowed to call the API with cookies
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Workspace SSO
GOOGLE_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN=briteaba.com
# Service account (domain-wide delegation) for Directory group reads and Shared Drive
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DIRECTORY_ADMIN_EMAIL=
GOOGLE_SHARED_DRIVE_ID=

# The two named BRITE administrators (System Owners)
BRITE_SYSTEM_OWNER_EMAILS=

# Development-only sign-in without Google (ignored when DEBUG is False)
DEV_AUTH_ENABLED=False
